{
  "$schema": "node_modules/knip/schema.json",
  "entry": ["src/routes/**/*.{ts,svelte}"],
  "project": ["src/**/*.{ts,svelte,css}", "scripts/**/*.ts"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "off",
    "types": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "nsExports": "off",
    "nsTypes": "off"
  }
}
